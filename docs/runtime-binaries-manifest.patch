+describe('prepared OpenBook runtime release', () => {
+  it('maps exactly the five built assets to immutable versioned ZIP URLs', () => {
+    expect(PENDING_OWN_RUNTIME_ASSETS).toHaveLength(5);
+    expect(new Set(PENDING_OWN_RUNTIME_ASSETS.map(p => `${p.target}/${p.tool}`)).size).toBe(5);
+    for (const pending of PENDING_OWN_RUNTIME_ASSETS) {
+      expect(ownRuntimeAssetUrl(pending.asset)).toBe(
+        `https://github.com/lab255/OpenBook/releases/download/runtime-binaries-v1/${pending.tool}-${pending.version}-${pending.target}.zip`,
+      );
+      expect(pending.binaryPath).toBe(pending.target === 'x86_64-pc-windows-msvc' ? 'whisper-cli.exe' : pending.tool);
+    }
+  });
+
+  it('leaves unsupported tools and existing Windows pins unchanged until publication', () => {
+    for (const pending of PENDING_OWN_RUNTIME_ASSETS) {
+      const active = RUNTIME_MANIFEST[pending.target][pending.tool];
+      if (pending.target === 'x86_64-pc-windows-msvc') {
+        expect(active.status).toBe('supported');
+        if (active.status !== 'supported') throw new Error('Windows upstream pin missing');
+        expect(active.url).toContain('github.com/ggml-org/whisper.cpp/');
+        expect(active.extractDir).toBe('Release');
+      } else {
+        expect(active.status).toBe('unsupported');
+      }
+    }
